#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LOWER   1
#define FUNC    2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // BFO-9000 Right Half as Macro Pad (9 columns x 6 rows = 54 keys)
            bindings = <
                &kp ESC   &kp GRAVE &kp SLASH &kp PRSCN &kp SLCK  &kp PAUSE_BREAK &kp C &kp V &kp KP_NLCK  
                &kp F1    &kp F2    &kp F3    &kp INS   &kp HOME  &kp PG_UP &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_SUBTRACT
                &kp F4    &kp F5    &kp F6    &kp DEL   &kp END   &kp PG_DN &kp KP_N7 &kp KP_N8 &kp KP_N9
                &kp F7    &kp F8    &kp F9    &kp C_VOL_UP &kp C_MUTE &kp C_VOL_DN  &kp KP_N4 &kp KP_N5 &mo KP_N6
                &kp F10   &kp F11   &kp F12   &kp C_RW &kp C_PP &kp C_FF &kp KP_N1 &kp KP_N2 &mo KP_N3
                &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp KP_PLUS &kp KP_N0 &kp KP_DOT
            >;
        };

        lower_layer {
            // Lower Layer - Bluetooth & System Controls
            // -------------------------------------------------------------------------
            // | BT_CLR | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |       |       |Bootldr|
            // | USB    | BLE   |       |       |       |       |       |       | Reset |
            // | EP_ON  | EP_OFF|       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            bindings = <
                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &bootloader
                &out OUT_USB &out OUT_BLE &trans       &trans       &trans       &trans       &trans &trans &sys_reset
                &ext_power EP_ON &ext_power EP_OFF &trans &trans   &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
            >;
        };

        func_layer {
            // Function Layer - Numpad & Media
            // -------------------------------------------------------------------------
            // | Esc   | NumLk | /     | *     | -     |       |       |       |       |
            // |       | 7     | 8     | 9     | +     |       |       |       |       |
            // |       | 4     | 5     | 6     | +     |       |       |       |       |
            // |       | 1     | 2     | 3     | Enter |       |       |       |       |
            // |       | 0     | 0     | .     | Enter |       |       | VolUp |       |
            // | Mute  | Prev  | Play  | Next  |       |       |       | VolDn |       |
            bindings = <
                &kp ESC   &kp KP_NUM   &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS &trans &trans &trans &trans
                &trans    &kp KP_N7    &kp KP_N8    &kp KP_N9       &kp KP_PLUS  &trans &trans &trans &trans
                &trans    &kp KP_N4    &kp KP_N5    &kp KP_N6       &kp KP_PLUS  &trans &trans &trans &trans
                &trans    &kp KP_N1    &kp KP_N2    &kp KP_N3       &kp KP_ENTER &trans &trans &trans &trans
                &trans    &kp KP_N0    &kp KP_N0    &kp KP_DOT      &kp KP_ENTER &trans &trans &kp C_VOL_UP &trans
                &kp C_MUTE &kp C_PREV  &kp C_PP     &kp C_NEXT      &trans       &trans &trans &kp C_VOL_DN &trans
            >;
        };
    };
};
