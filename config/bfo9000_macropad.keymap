#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LOWER   1
#define FUNC    2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // BFO-9000 Right Half as Macro Pad (9 columns x 6 rows = 54 keys)
            // -------------------------------------------------------------------------
            // | F5    | F6    | F7    | F8    | F9    | F10   | F11   | F12   | Del   |
            // | 5     | 6     | 7     | 8     | 9     | 0     | -     | =     | BkSpc |
            // | T     | Y     | U     | I     | O     | P     | [     | ]     | \     |
            // | G     | H     | J     | K     | L     | ;     | '     | Enter | FUNC  |
            // | B     | N     | M     | ,     | .     | /     | Shift | Up    | LOWER |
            // | BkSpc | Space | Space | Win   | Alt   | Ctrl  | Left  | Down  | Right |
            bindings = <
                &kp F5    &kp F6    &kp F7    &kp F8    &kp F9   &kp F10   &kp F11   &kp F12   &kp DEL
                &kp N5    &kp N6    &kp N7    &kp N8    &kp N9   &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp T     &kp Y     &kp U     &kp I     &kp O    &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp G     &kp H     &kp J     &kp K     &kp L    &kp SEMI  &kp APOS  &kp ENTER &mo FUNC
                &kp B     &kp N     &kp M     &kp COMMA &kp DOT  &kp SLASH &kp RSHFT &kp UP    &mo LOWER
                &kp BSPC  &kp SPACE &kp SPACE &kp RMETA &kp RALT &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        lower_layer {
            // Lower Layer - Bluetooth & System Controls
            // -------------------------------------------------------------------------
            // | BT_CLR | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |       |       |Bootldr|
            // | USB    | BLE   |       |       |       |       |       |       | Reset |
            // | EP_ON  | EP_OFF|       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            // |        |       |       |       |       |       |       |       |       |
            bindings = <
                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &bootloader
                &out OUT_USB &out OUT_BLE &trans       &trans       &trans       &trans       &trans &trans &sys_reset
                &ext_power EP_ON &ext_power EP_OFF &trans &trans   &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans
            >;
        };

        func_layer {
            // Function Layer - Numpad & Media
            // -------------------------------------------------------------------------
            // | Esc   | NumLk | /     | *     | -     |       |       |       |       |
            // |       | 7     | 8     | 9     | +     |       |       |       |       |
            // |       | 4     | 5     | 6     | +     |       |       |       |       |
            // |       | 1     | 2     | 3     | Enter |       |       |       |       |
            // |       | 0     | 0     | .     | Enter |       |       | VolUp |       |
            // | Mute  | Prev  | Play  | Next  |       |       |       | VolDn |       |
            bindings = <
                &kp ESC   &kp KP_NUM   &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS &trans &trans &trans &trans
                &trans    &kp KP_N7    &kp KP_N8    &kp KP_N9       &kp KP_PLUS  &trans &trans &trans &trans
                &trans    &kp KP_N4    &kp KP_N5    &kp KP_N6       &kp KP_PLUS  &trans &trans &trans &trans
                &trans    &kp KP_N1    &kp KP_N2    &kp KP_N3       &kp KP_ENTER &trans &trans &trans &trans
                &trans    &kp KP_N0    &kp KP_N0    &kp KP_DOT      &kp KP_ENTER &trans &trans &kp C_VOL_UP &trans
                &kp C_MUTE &kp C_PREV  &kp C_PP     &kp C_NEXT      &trans       &trans &trans &kp C_VOL_DN &trans
            >;
        };
    };
};
