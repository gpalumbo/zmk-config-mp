#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define BT_LAYER 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // --------------------------
            // | NLCK |  /   |  *   |  -  |
            // |  7   |  8   |  9   |     |
            // |  4   |  5   |  6   |  +  |
            // |  1   |  2   |  3   |     |
            // |      0      |  .   | ENT |
            // --------------------------
            bindings = <
                &kp KP_NUM    &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7     &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4     &kp KP_N5        &kp KP_N6
                &kp KP_N1     &kp KP_N2        &kp KP_N3        &kp KP_ENTER
                &mo BT_LAYER  &kp KP_N0        &kp KP_DOT
            >;
        };

        bt_layer {
            // --------------------------
            // | BTCLR | BT1  | BT2  | BT3 |
            // | BT4   | BT5  |      |     |
            // |       |      |      |     |
            // |       |      |      |     |
            // |             |      |     |
            // --------------------------
            bindings = <
                &bt BT_CLR    &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2
                &bt BT_SEL 3  &bt BT_SEL 4     &none            &none
                &none         &none            &none
                &none         &none            &none            &none
                &trans        &none            &none
            >;
        };
    };
};
